#version 450

// No motion where the HUD is (the last frame's mask, widened by four pixels for the final pass's
// filtering and a HUD element that moved), so AMD frame generation keeps the HUD still.

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D hud_mask;
layout(binding = 1, rg16f) uniform image2D motion;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(motion);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    ivec2 mask_size = textureSize(hud_mask, 0);
    vec2 mask_scale = vec2(mask_size) / vec2(extent);
    float hud = 0.0;
    for (int y = -4; y <= 4; ++y) {
        for (int x = -4; x <= 4; ++x) {
            ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), extent - 1);
            // The mask is at the output size; the scene can be smaller (the game's dynamic
            // resolution, e.g. 1440x810 upscaled to 1080p): take the mask pixel at the same place.
            ivec2 mask_at = clamp(ivec2((vec2(at) + 0.5) * mask_scale), ivec2(0), mask_size - 1);
            hud = max(hud, texelFetch(hud_mask, mask_at, 0).r);
        }
    }
    if (hud > 0.5) {
        imageStore(motion, pixel, vec4(0.0));
    }
}
